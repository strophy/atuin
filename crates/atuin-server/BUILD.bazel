        "src/handlers/health.rs",
        "src/handlers/history.rs",
        "src/handlers/mod.rs",
        "src/handlers/record.rs",
        "src/handlers/status.rs",
        "src/handlers/user.rs",
        "src/handlers/v0/me.rs",
        "src/handlers/v0/mod.rs",
        "src/handlers/v0/record.rs",
        "src/handlers/v0/store.rs",
        "src/lib.rs",
        "src/metrics.rs",
        "src/router.rs",
        "src/settings.rs",
        "src/utils.rs",
    ],
    compile_data = [
        "Cargo.toml",
        "server.toml",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/atuin-common:atuin_common",
        "//crates/atuin-server-database:atuin_server_database",
        "@crates//:argon2",
