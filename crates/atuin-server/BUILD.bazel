    srcs = ["src/bin/main.rs"],
    compile_data = ["Cargo.toml"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        ":atuin_server",
        "//crates/atuin-server-database:atuin_server_database",
        "//crates/atuin-server-postgres:atuin_server_postgres",
        "//crates/atuin-server-sqlite:atuin_server_sqlite",
